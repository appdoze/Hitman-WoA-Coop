*.user
*.suo

# Node (Peacock plugin, relay, tools)
node_modules/
dist/
*.log
.yarn/*
!.yarn/releases
!.yarn/plugins

# Local test data: never commit profiles, logs or captures
userdata/
userdata-*/
backups/
logs/
*.dmp
*.pcap
*.pcapng
recordings/
message-logs/

# Game files and reverse-engineering databases (see CONTRIBUTING.md)
*.rpkg
*.i64
*.idb
*.gzf
*.bndb

# Fuzzing output (libFuzzer writes crash-*, leak-*, timeout-* and oom-* into the
# directory it runs in). Only ignored inside fuzz/ so source files such as
# mod/src/crash-reporter.cpp aren't hidden. Seed corpora in fuzz/**/corpus/ are
# committed on purpose; only generated corpora are ignored.
fuzz/**/crash-*
fuzz/**/leak-*
fuzz/**/timeout-*
fuzz/**/oom-*
fuzz/**/corpus/generated/

# OS
.DS_Store
Thumbs.db
desktop.ini
